# ExperimentPilot Backend Environment Variables Template
# Copy to backend/.env for local overrides, or set in Render Environment Variables.

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins, or * for all)
# In production, set to your Vercel deployment URL (e.g. https://experimentpilot.vercel.app)
CORS_ORIGINS=*

# Optional Persistent Database Path (for Render Persistent Disks, e.g. /var/data/experimentpilot.db)
# If omitted, defaults to backend/data/experimentpilot.db
# DB_PATH=/var/data/experimentpilot.db

# Optional External LLM Keys (deterministic offline engine runs without keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
