# ExperimentPilot Backend Environment Variables Template
# Copy to backend/.env to configure LLM providers.
# Deterministic analytics run completely offline without keys.

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

HOST=127.0.0.1
PORT=8000
