# ExperimentPilot Environment Variables Template
# Copy this file to .env for local configuration or reference when setting hosting env vars.

# --- Backend Configuration (Render) ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
# DB_PATH=/var/data/experimentpilot.db

# Optional LLM API Keys (backend offline analytics run without keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Frontend Configuration (Vercel) ---
VITE_API_URL=https://your-backend-service.onrender.com
