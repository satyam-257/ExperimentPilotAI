# ExperimentPilot Environment Variables Template
# Copy this file to .env and insert your API keys if you wish to use external LLM providers.
# Offline deterministic analytics function without any API keys.

# Optional: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI-compatible API Key & Base URL
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Configuration
HOST=127.0.0.1
PORT=8000
